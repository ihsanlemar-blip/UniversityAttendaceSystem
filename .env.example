# ==============================================================================
# DIGITAL STUDENT ATTENDANCE SYSTEM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# DO NOT place real production secrets or private keys in this example file.
# ==============================================================================

# --- Application Core Settings ---
APP_ENV=development
APP_NAME=University Attendance System
APP_VERSION=0.1.0
DEBUG=true

# --- Institutional Settings ---
UNIVERSITY_ID=00000000-0000-0000-0000-000000000001
UNIVERSITY_NAME=Kabul University
UNIVERSITY_TIMEZONE=Asia/Kabul
DEFAULT_LOCALE=en

# --- PostgreSQL Primary Database ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=attendance_db
DATABASE_USER=attendance_user
DATABASE_PASSWORD=dev_insecure_password
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_SSL_MODE=disable

# --- Redis Transient Cache & Celery Broker ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Authentication & JWT Security ---
# Generate secure 256-bit key in production: openssl rand -hex 32
AUTH_SIGNING_KEY=dev_insecure_jwt_signing_key_do_not_use_in_production
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=7
AUTH_PASSWORD_HASH_ALGO=argon2id
AUTH_MAX_LOGIN_ATTEMPTS=5

# --- Core Attendance & Token Invariants ---
ATTENDANCE_TOKEN_ROTATION_SECONDS=30
ATTENDANCE_TOKEN_TOLERANCE_STEPS=1
ATTENDANCE_DEFAULT_CHECKPOINT_SECONDS=300
ATTENDANCE_LATE_THRESHOLD_MINUTES=10
ATTENDANCE_MINIMUM_PERCENTAGE=75.0
ATTENDANCE_TOKEN_HMAC_SECRET=dev_insecure_qr_hmac_secret_do_not_use_in_prod

# --- Campus Network Verification ---
CAMPUS_TRUSTED_SUBNETS=192.168.0.0/16,10.0.0.0/8
CAMPUS_NETWORK_CHECK_ENABLED=true

# --- Service Host URLs ---
LOCAL_SERVER_BASE_URL=http://localhost:8000
PUBLIC_WEB_BASE_URL=http://localhost:3000

# --- Cloud Disaster Recovery Synchronization ---
CLOUD_SYNC_ENABLED=false
CLOUD_SYNC_URL=https://cloud.university.edu/api/v1/sync
CLOUD_SYNC_API_KEY=placeholder_cloud_sync_api_key
CLOUD_SYNC_BATCH_SIZE=100

# --- Campus Automated Backup ---
BACKUP_ENABLED=true
BACKUP_PATH=/var/backups/attendance
BACKUP_RETENTION_DAYS=30

# --- Logging & Observability ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Web Frontend (Next.js Public Variables) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=University Attendance Portal
NEXT_PUBLIC_DEFAULT_LOCALE=en

# --- Mobile Client (Flutter Configuration) ---
APP_API_BASE_URL=http://10.0.2.2:8000/api/v1
APP_BLE_SERVICE_UUID=0000fee0-0000-1000-8000-00805f9b34fb
